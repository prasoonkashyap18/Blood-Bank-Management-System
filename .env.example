# Copy this file to .env and fill in real values. Never commit the real .env file.

# Random secret used to sign session cookies and CSRF tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-random-generated-value

# Set to true only once the app is served over HTTPS.
SESSION_COOKIE_SECURE=false

# Optional override; defaults to instance/bloodbank.db inside the project.
# DATABASE_PATH=instance/bloodbank.db

# Used only by database/create_admin.py to provision a local admin account.
# ADMIN_PASSWORD must be a real password of at least 8 characters.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
